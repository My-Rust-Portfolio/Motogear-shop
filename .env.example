POSTGRES_USER=motogear
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=motogear

# Connection settings for Rust commands run directly on the host.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Address for the API when running directly on the host.
API_BIND_ADDRESS=127.0.0.1:3000

# PostgreSQL database used only by integration tests.
# Use a separate database from the development database.
TEST_DATABASE_URL=postgres://motogear:replace_with_local_password@localhost:5433/motogear_test